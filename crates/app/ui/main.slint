import { Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Strip } from "strip.slint";
import { ConnectScreen, Beacon } from "connect.slint";
import { OutputPage, WheelInfo } from "output.slint";
import { ManualPage, PresetInfo } from "manual.slint";
import { AutoPage } from "auto.slint";
import { ConsoleState, ConsoleRow, ConsoleSpan, ConsoleTabInfo } from "console.slint";

export { Beacon, WheelInfo, PresetInfo, ConsoleState, ConsoleRow, ConsoleSpan, ConsoleTabInfo }

// Properties are set by glue.rs; later tasks add more but keep these stable.
export component MainWindow inherits Window {
    title: "oumuamua";
    init => { Palette.color-scheme = ColorScheme.dark; }
    background: Theme.bg;
    preferred-width: 1280px;
    preferred-height: 640px;

    // Visible page: 0 output, 1 manual, 2 auto.
    in-out property <int> page: 0;
    // False shows the connection screen instead of the pages.
    in property <bool> connected: false;
    // Connected to the in-app demo robot (badge in the strip and the output band).
    in property <bool> demo: false;
    callback connect-demo();
    callback disconnect();
    property <bool> confirm-leave: false;
    // Strip: link status text/colour, rtt in ms (-1 unknown), stop latch ("解除" shown).
    in property <string> conn-text: "未接続";
    in property <color> conn-color: Theme.dim;
    in property <int> rtt-ms: -1;
    in property <bool> stopped: false;
    // Robot mode: 0 manual, 1 auto, 2 stopped, -1 unknown.
    in property <int> mode: -1;
    // Failure reason shown at the bottom of the content area ("" = hidden).
    in property <string> notice;
    // Connection screen.
    in property <[Beacon]> beacons;
    in-out property <string> target;
    in property <string> connect-status;
    in property <color> connect-status-color: Theme.dim;

    // Output page: status band and map (the map image is rendered by map.rs).
    in property <string> band-pose: "位置 -";
    in property <string> band-vel: "速度 -";
    in property <[WheelInfo]> band-wheels;
    in property <string> band-mode;
    in property <color> band-mode-color: Theme.dim;
    in property <string> band-reason;
    in property <image> map-image;
    in property <float> map-cx;
    in property <float> map-cy;
    in property <float> map-scale: 50;

    // Manual page. Selections live here so they survive page switches.
    in-out property <int> manual-level: 0;
    in-out property <bool> manual-field-frame: false;
    in-out property <bool> manual-both: false;
    in property <[PresetInfo]> manual-presets;
    in property <string> manual-lift-reason;
    in property <string> manual-left-info: "高さ —  目標 —";
    in property <string> manual-right-info: "高さ —  目標 —";
    in property <bool> manual-left-suction: false;
    in property <bool> manual-right-suction: false;
    in property <bool> manual-reset-enabled: true;
    in property <string> manual-message;
    in property <string> manual-speed-text;
    in property <string> manual-auto-label;

    // Auto page. Selections live here so they survive page switches.
    in-out property <int> auto-pick-gripper: 0;
    in-out property <int> auto-place-gripper: 0;
    in-out property <int> auto-block: -1;
    in-out property <int> auto-column: -1;
    in-out property <int> auto-row: -1;
    in property <string> auto-block-reason;
    in property <bool> auto-task-active: false;
    in property <string> auto-task-label;
    in property <string> auto-task-step;
    in property <[int]> auto-blocks;
    in property <[int]> auto-cells;
    in property <int> auto-columns: 3;
    in property <int> auto-rows: 3;
    in property <bool> auto-hold-left: false;
    in property <bool> auto-hold-right: false;
    in property <string> auto-place-warning;
    in property <string> auto-memory-text;
    in property <bool> auto-forget-enabled: true;
    in property <[string]> auto-paths;
    in property <string> auto-active-path;
    in property <bool> auto-tracker: false;
    in property <string> auto-message;
    in property <bool> auto-message-ok: true;
    in property <image> auto-map-image;
    in property <float> auto-map-cx;
    in property <float> auto-map-cy;
    in property <float> auto-map-scale: 50;
    in property <string> auto-confirm-text;
    in property <bool> auto-confirm-active: false;

    callback connect(string, bool);
    callback auto-run-pick(int, int);
    callback auto-run-place(int, int, int);
    callback auto-run-move(int);
    callback auto-cancel();
    callback auto-forget-pressed();
    callback auto-forget();
    callback auto-start-path(string);
    callback auto-stop-path();
    callback auto-toggle-tracker();
    callback auto-pose-dragging(float, float, float);
    callback auto-pose-picked(float, float, float);
    callback auto-pose-cancelled();
    callback auto-pose-confirm();
    callback auto-pose-dismiss();
    callback manual-stick(float, float);
    callback manual-slider(float);
    callback manual-jog(int, int);
    callback manual-jog-released(int);
    callback manual-preset(int, int);
    callback manual-suction(int);
    callback manual-reset-pressed();
    callback manual-reset();
    callback manual-cancel-auto();
    // Level / frame / both changed on the page.
    callback manual-options-changed();
    // Map pane 0 (output page); pane id first so more panes can share the Rust side.
    callback map-geometry(int, length, length);
    callback map-panned(int, length, length);
    callback map-zoomed(int, float, length, length);
    callback map-fit(int);
    // The window lost focus / was paused: release every held input.
    callback window-deactivated();
    callback stop-pressed();
    callback release-pressed();

    property <length> inset-top: root.safe-area-insets.top;
    property <length> inset-bottom: root.safe-area-insets.bottom;
    property <length> inset-left: root.safe-area-insets.left;
    property <length> inset-right: root.safe-area-insets.right;

    // Holds the keyboard focus so that deactivating the window (focus lost, Android pause)
    // can be seen as has-focus going false.
    focus-watch := FocusScope {
        width: 0px;
        height: 0px;
        init => { self.focus(); }
        changed has-focus => { if !self.has-focus { root.window-deactivated(); } }
    }

    HorizontalLayout {
        padding-top: root.inset-top;
        padding-bottom: root.inset-bottom;
        padding-left: root.inset-left;
        padding-right: root.inset-right;
        Rectangle {
            if !root.connected: ConnectScreen {
                beacons: root.beacons;
                target <=> root.target;
                status: root.connect-status;
                status-color: root.connect-status-color;
                connect(t, takeover) => { root.connect(t, takeover); }
                connect-demo => { root.connect-demo(); }
            }
            if root.connected: Rectangle {
                if root.page == 0: OutputPage {
                    pose-text: root.band-pose;
                    vel-text: root.band-vel;
                    wheels: root.band-wheels;
                    demo: root.demo;
                    mode-text: root.band-mode;
                    mode-color: root.band-mode-color;
                    reason-text: root.band-reason;
                    window-height: root.height;
                    map-image: root.map-image;
                    map-cx: root.map-cx;
                    map-cy: root.map-cy;
                    map-scale: root.map-scale;
                    map-geometry(w, h) => { root.map-geometry(0, w, h); }
                    map-panned(dx, dy) => { root.map-panned(0, dx, dy); }
                    map-zoomed(f, x, y) => { root.map-zoomed(0, f, x, y); }
                    map-fit => { root.map-fit(0); }
                }
                if root.page == 1: ManualPage {
                    level <=> root.manual-level;
                    field-frame <=> root.manual-field-frame;
                    both <=> root.manual-both;
                    presets: root.manual-presets;
                    lift-reason: root.manual-lift-reason;
                    left-info: root.manual-left-info;
                    right-info: root.manual-right-info;
                    left-suction: root.manual-left-suction;
                    right-suction: root.manual-right-suction;
                    reset-enabled: root.manual-reset-enabled;
                    stopped: root.stopped;
                    message: root.manual-message;
                    speed-text: root.manual-speed-text;
                    auto-active: root.mode == 1;
                    auto-label: root.manual-auto-label;
                    stick-moved(x, y) => { root.manual-stick(x, y); }
                    slider-moved(s) => { root.manual-slider(s); }
                    jog-pressed(side, dir) => { root.manual-jog(side, dir); }
                    jog-released(s) => { root.manual-jog-released(s); }
                    preset-pressed(side, i) => { root.manual-preset(side, i); }
                    suction-toggled(side) => { root.manual-suction(side); }
                    reset-pressed => { root.manual-reset-pressed(); }
                    reset-confirmed => { root.manual-reset(); }
                    cancel-auto => { root.manual-cancel-auto(); }
                    changed level => { root.manual-options-changed(); }
                    changed field-frame => { root.manual-options-changed(); }
                    changed both => { root.manual-options-changed(); }
                }
                if root.page == 2: AutoPage {
                    stopped: root.stopped;
                    pick-gripper <=> root.auto-pick-gripper;
                    place-gripper <=> root.auto-place-gripper;
                    sel-block <=> root.auto-block;
                    sel-column <=> root.auto-column;
                    sel-row <=> root.auto-row;
                    block-reason: root.auto-block-reason;
                    task-active: root.auto-task-active;
                    task-label: root.auto-task-label;
                    task-step: root.auto-task-step;
                    blocks: root.auto-blocks;
                    cells: root.auto-cells;
                    columns: root.auto-columns;
                    rows: root.auto-rows;
                    hold-left: root.auto-hold-left;
                    hold-right: root.auto-hold-right;
                    place-warning: root.auto-place-warning;
                    memory-text: root.auto-memory-text;
                    forget-enabled: root.auto-forget-enabled;
                    paths: root.auto-paths;
                    active-path: root.auto-active-path;
                    tracker: root.auto-tracker;
                    message: root.auto-message;
                    message-ok: root.auto-message-ok;
                    map-image: root.auto-map-image;
                    map-cx: root.auto-map-cx;
                    map-cy: root.auto-map-cy;
                    map-scale: root.auto-map-scale;
                    confirm-text: root.auto-confirm-text;
                    confirm-active: root.auto-confirm-active;
                    run-pick(g, b) => { root.auto-run-pick(g, b); }
                    run-place(g, c, r) => { root.auto-run-place(g, c, r); }
                    run-move(k) => { root.auto-run-move(k); }
                    cancel => { root.auto-cancel(); }
                    forget-pressed => { root.auto-forget-pressed(); }
                    forget-confirmed => { root.auto-forget(); }
                    start-path(n) => { root.auto-start-path(n); }
                    stop-path => { root.auto-stop-path(); }
                    toggle-tracker => { root.auto-toggle-tracker(); }
                    map-geometry(w, h) => { root.map-geometry(1, w, h); }
                    map-panned(dx, dy) => { root.map-panned(1, dx, dy); }
                    map-zoomed(f, x, y) => { root.map-zoomed(1, f, x, y); }
                    map-fit => { root.map-fit(1); }
                    pose-dragging(x, y, yaw) => { root.auto-pose-dragging(x, y, yaw); }
                    pose-picked(x, y, yaw) => { root.auto-pose-picked(x, y, yaw); }
                    pose-cancelled => { root.auto-pose-cancelled(); }
                    pose-confirm => { root.auto-pose-confirm(); }
                    pose-dismiss => { root.auto-pose-dismiss(); }
                }
                if root.notice != "": Rectangle {
                    y: parent.height - self.height;
                    height: 40px;
                    background: Theme.danger;
                    Text { text: root.notice; color: #ffffff; font-size: Theme.font; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }
        Strip {
            width: Theme.strip-width;
            page <=> root.page;
            conn-text: root.conn-text;
            conn-color: root.conn-color;
            rtt-ms: root.rtt-ms;
            stopped: root.stopped;
            demo: root.demo;
            connected: root.connected;
            disconnect-pressed => { root.confirm-leave = true; }
            mode-text: root.mode == 0 ? "手動" : root.mode == 1 ? "自動" : root.mode == 2 ? "停止" : "";
            stop-pressed => { root.stop-pressed(); }
            release-pressed => { root.release-pressed(); }
        }
    }
    if root.confirm-leave: Rectangle {
        background: #000000a0;
        TouchArea { }
        Rectangle {
            width: 440px;
            height: 160px;
            background: Theme.panel;
            border-radius: 12px;
            VerticalLayout {
                padding: 16px;
                spacing: 16px;
                Text { text: "切断して接続先を選びますか"; color: Theme.text; font-size: 20px; horizontal-alignment: center; vertical-alignment: center; }
                HorizontalLayout {
                    spacing: 16px;
                    Rectangle {
                        height: Theme.tap;
                        background: Theme.panel-hi;
                        border-radius: 8px;
                        Text { text: "いいえ"; color: Theme.text; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.confirm-leave = false; } }
                    }
                    Rectangle {
                        height: Theme.tap;
                        background: Theme.accent;
                        border-radius: 8px;
                        Text { text: "はい"; color: Theme.text; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.confirm-leave = false; root.disconnect(); } }
                    }
                }
            }
        }
    }
}
