import { Palette } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Strip } from "strip.slint";
import { ConnectScreen, Beacon } from "connect.slint";
import { OutputPage, WheelInfo } from "output.slint";
import { ManualPage, PresetInfo } from "manual.slint";

export { Beacon, WheelInfo, PresetInfo }

// Placeholder pages; Tasks 14-16 replace the bodies.
component AutoPage inherits Rectangle { background: Theme.bg; Text { text: "自動"; color: Theme.dim; } }

// Properties are set by glue.rs; later tasks add more but keep these stable.
export component MainWindow inherits Window {
    title: "oumuamua";
    init => { Palette.color-scheme = ColorScheme.dark; }
    background: Theme.bg;
    preferred-width: 1280px;
    preferred-height: 640px;

    // Visible page: 0 output, 1 manual, 2 auto.
    in-out property <int> page: 0;
    // False shows the connection screen instead of the pages.
    in property <bool> connected: false;
    // Strip: link status text/colour, rtt in ms (-1 unknown), stop latch ("解除" shown).
    in property <string> conn-text: "未接続";
    in property <color> conn-color: Theme.dim;
    in property <int> rtt-ms: -1;
    in property <bool> stopped: false;
    // Robot mode: 0 manual, 1 auto, 2 stopped, -1 unknown.
    in property <int> mode: -1;
    // Failure reason shown at the bottom of the content area ("" = hidden).
    in property <string> notice;
    // Connection screen.
    in property <[Beacon]> beacons;
    in-out property <string> target;
    in property <string> connect-status;
    in property <color> connect-status-color: Theme.dim;

    // Output page: status band and map (the map image is rendered by map.rs).
    in property <string> band-pose: "位置 -";
    in property <string> band-vel: "速度 -";
    in property <[WheelInfo]> band-wheels;
    in property <string> band-mode;
    in property <color> band-mode-color: Theme.dim;
    in property <string> band-reason;
    in property <image> map-image;
    in property <float> map-cx;
    in property <float> map-cy;
    in property <float> map-scale: 50;

    // Manual page. Selections live here so they survive page switches.
    in-out property <int> manual-level: 0;
    in-out property <bool> manual-field-frame: false;
    in-out property <bool> manual-both: false;
    in property <[PresetInfo]> manual-presets;
    in property <string> manual-lift-reason;
    in property <string> manual-left-info: "高さ —  目標 —";
    in property <string> manual-right-info: "高さ —  目標 —";
    in property <bool> manual-left-suction: false;
    in property <bool> manual-right-suction: false;
    in property <bool> manual-reset-enabled: true;
    in property <string> manual-message;
    in property <string> manual-speed-text;
    in property <string> manual-auto-label;

    callback connect(string, bool);
    callback manual-stick(float, float);
    callback manual-slider(float);
    callback manual-jog(int, int);
    callback manual-jog-released();
    callback manual-preset(int, int);
    callback manual-suction(int);
    callback manual-reset-pressed();
    callback manual-reset();
    callback manual-cancel-auto();
    // Level / frame / both changed on the page.
    callback manual-options-changed();
    // Map pane 0 (output page); pane id first so more panes can share the Rust side.
    callback map-geometry(int, length, length);
    callback map-panned(int, length, length);
    callback map-zoomed(int, float, length, length);
    callback map-fit(int);
    callback stop-pressed();
    callback release-pressed();

    property <length> inset-top: root.safe-area-insets.top;
    property <length> inset-bottom: root.safe-area-insets.bottom;
    property <length> inset-left: root.safe-area-insets.left;
    property <length> inset-right: root.safe-area-insets.right;

    HorizontalLayout {
        padding-top: root.inset-top;
        padding-bottom: root.inset-bottom;
        padding-left: root.inset-left;
        padding-right: root.inset-right;
        Rectangle {
            if !root.connected: ConnectScreen {
                beacons: root.beacons;
                target <=> root.target;
                status: root.connect-status;
                status-color: root.connect-status-color;
                connect(t, takeover) => { root.connect(t, takeover); }
            }
            if root.connected: Rectangle {
                if root.page == 0: OutputPage {
                    pose-text: root.band-pose;
                    vel-text: root.band-vel;
                    wheels: root.band-wheels;
                    mode-text: root.band-mode;
                    mode-color: root.band-mode-color;
                    reason-text: root.band-reason;
                    map-image: root.map-image;
                    map-cx: root.map-cx;
                    map-cy: root.map-cy;
                    map-scale: root.map-scale;
                    map-geometry(w, h) => { root.map-geometry(0, w, h); }
                    map-panned(dx, dy) => { root.map-panned(0, dx, dy); }
                    map-zoomed(f, x, y) => { root.map-zoomed(0, f, x, y); }
                    map-fit => { root.map-fit(0); }
                }
                if root.page == 1: ManualPage {
                    level <=> root.manual-level;
                    field-frame <=> root.manual-field-frame;
                    both <=> root.manual-both;
                    presets: root.manual-presets;
                    lift-reason: root.manual-lift-reason;
                    left-info: root.manual-left-info;
                    right-info: root.manual-right-info;
                    left-suction: root.manual-left-suction;
                    right-suction: root.manual-right-suction;
                    reset-enabled: root.manual-reset-enabled;
                    message: root.manual-message;
                    speed-text: root.manual-speed-text;
                    auto-active: root.mode == 1;
                    auto-label: root.manual-auto-label;
                    stick-moved(x, y) => { root.manual-stick(x, y); }
                    slider-moved(s) => { root.manual-slider(s); }
                    jog-pressed(side, dir) => { root.manual-jog(side, dir); }
                    jog-released => { root.manual-jog-released(); }
                    preset-pressed(side, i) => { root.manual-preset(side, i); }
                    suction-toggled(side) => { root.manual-suction(side); }
                    reset-pressed => { root.manual-reset-pressed(); }
                    reset-confirmed => { root.manual-reset(); }
                    cancel-auto => { root.manual-cancel-auto(); }
                    changed level => { root.manual-options-changed(); }
                    changed field-frame => { root.manual-options-changed(); }
                    changed both => { root.manual-options-changed(); }
                }
                if root.page == 2: AutoPage { }
                if root.notice != "": Rectangle {
                    y: parent.height - self.height;
                    height: 40px;
                    background: Theme.danger;
                    Text { text: root.notice; color: #ffffff; font-size: Theme.font; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }
        Strip {
            width: Theme.strip-width;
            page <=> root.page;
            conn-text: root.conn-text;
            conn-color: root.conn-color;
            rtt-ms: root.rtt-ms;
            stopped: root.stopped;
            mode-text: root.mode == 0 ? "手動" : root.mode == 1 ? "自動" : root.mode == 2 ? "停止" : "";
            stop-pressed => { root.stop-pressed(); }
            release-pressed => { root.release-pressed(); }
        }
    }
}
