import { Theme } from "theme.slint";
import { Btn } from "manual.slint";

// 左 / 右 chooser. A side that cannot be chosen (`left-ok` / `right-ok` false) is dimmed.
component SidePick inherits HorizontalLayout {
    in-out property <int> value: 0;
    in property <bool> left-ok: true;
    in property <bool> right-ok: true;
    spacing: 6px;
    Btn { label: "左"; active: root.value == 0; enabled: root.left-ok; min-width: 56px; clicked => { root.value = 0; } }
    Btn { label: "右"; active: root.value == 1; enabled: root.right-ok; min-width: 56px; clicked => { root.value = 1; } }
}

// A semi-transparent plate with a heading; the map shows through around it.
component Panel inherits Rectangle {
    in property <string> title;
    in property <string> note;
    background: Theme.plate;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.panel-hi;
    VerticalLayout {
        padding: 4px;
        spacing: 3px;
        HorizontalLayout {
            height: 16px;
            spacing: 6px;
            Text { text: root.title; color: Theme.dim; font-size: 12px; vertical-alignment: center; }
            Text { text: root.note; color: Theme.warn; font-size: 12px; vertical-alignment: center; overflow: elide; }
        }
        @children
    }
}

// Drawn over the output screen: no background of its own, only plates around the controls.
export component AutoPanel inherits Rectangle {
    background: transparent;

    // Why the task buttons are unusable ("" = usable).
    in property <string> block-reason;
    in property <bool> task-active: false;
    in property <string> task-label;
    in property <string> task-step;
    // 0 free, 1 picked.
    in property <[int]> blocks;
    in property <int> columns: 3;
    in property <bool> hold-left: false;
    in property <bool> hold-right: false;
    in property <string> memory-text;
    in property <bool> forget-enabled: true;
    in property <[string]> paths;
    in property <string> active-path;
    in property <bool> tracker: false;
    in property <bool> stopped: false;
    in property <string> message;
    in property <bool> message-ok: true;
    in property <bool> link-ok: true;

    in-out property <int> pick-gripper: 0;
    in-out property <int> place-gripper: 0;
    in-out property <int> sel-block: -1;
    in-out property <int> sel-column: -1;

    callback run-pick(int, int);
    // マスへ (TO_SHELF_CELL): gripper, column.
    callback run-shelf-cell(int, int);
    // 2 個同時に回収 (PICK_PAIR): the block that gripper0 takes (gripper1 takes block - 1).
    callback run-pair(int);
    callback run-move(int);
    callback cancel();
    callback forget-pressed();
    callback forget-confirmed();
    callback start-path(string);
    callback stop-path();
    callback toggle-tracker();
    // 地図で姿勢を指定: the app switches to the output screen's map to pick a pose.
    callback pick-pose();

    property <bool> usable: root.block-reason == "" && root.link-ok;
    property <bool> can-pick: root.usable && root.sel-block >= 0 && root.sel-block < root.blocks.length && root.blocks[root.sel-block] == 0;
    property <bool> holds-selected: root.place-gripper == 0 ? root.hold-left : root.hold-right;
    property <bool> can-shelf-cell: root.usable && root.holds-selected && root.sel-column >= 0 && root.sel-column < root.columns;
    // A pair is free when both of its blocks exist and are not picked (an index past the end reads as 0).
    property <bool> can-pair-43: root.usable && root.blocks.length > 4 && root.blocks[4] == 0 && root.blocks[3] == 0;
    property <bool> can-pair-21: root.usable && root.blocks.length > 2 && root.blocks[2] == 0 && root.blocks[1] == 0;

    changed visible => { if !root.visible { root.forget-armed = false; } }
    changed forget-enabled => { if !root.forget-enabled { root.forget-armed = false; } }
    // 長押し: fires once after 1 s of an uninterrupted press.
    property <bool> forget-armed: false;
    forget-timer := Timer {
        interval: 1s;
        running: root.forget-armed && root.forget-enabled && root.visible;
        triggered => {
            root.forget-armed = false;
            root.forget-confirmed();
        }
    }


    property <length> margin: 8px;
    property <length> row-h: 44px;
    // Below the status band (it stays readable).
    property <length> top-y: Theme.band-h + 4px;
    property <length> side-w: 240px;

    // Swallows every touch that no control takes, so nothing reaches the output screen below.
    TouchArea { }

    // Top line: the running task and its step, or why nothing can be started; last result.
    Rectangle {
        x: root.margin;
        y: root.top-y;
        width: root.width - root.side-w - 3 * root.margin;
        height: 28px;
        border-radius: 10px;
        background: root.task-active ? Theme.accent.darker(0.5).with-alpha(0.9) : Theme.plate;
        HorizontalLayout {
            padding-left: 10px;
            padding-right: 10px;
            spacing: 12px;
            Text {
                text: root.task-active ? (root.task-step == "" ? "作業中: \{root.task-label}  段階: —" : "作業中: \{root.task-label}  段階: \{root.task-step}") : (root.block-reason != "" ? root.block-reason : "作業を選んでください");
                color: root.task-active || root.block-reason == "" ? Theme.text : Theme.warn;
                font-size: 15px;
                font-weight: 700;
                vertical-alignment: center;
                overflow: elide;
            }
            Text {
                text: root.message;
                color: root.message-ok ? Theme.text : Theme.warn;
                font-size: 13px;
                horizontal-alignment: right;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }

    // 回収 (left) and what the robot remembers.
    VerticalLayout {
        x: root.margin;
        y: root.top-y + 28px + 4px;
        width: 300px;
        spacing: 4px;
        Panel {
            title: "回収 (0 が外周壁の側)";
            height: 118px;
            HorizontalLayout {
                height: root.row-h;
                spacing: 4px;
                for st[i] in root.blocks: Btn {
                    label: st == 1 ? "\{i}済" : "\{i}";
                    enabled: st == 0;
                    active: root.sel-block == i;
                    min-width: 44px;
                    clicked => { root.sel-block = i; }
                }
            }
            HorizontalLayout {
                height: root.row-h;
                spacing: 8px;
                SidePick { value <=> root.pick-gripper; }
                Btn {
                    label: "回収";
                    tint: Theme.ok;
                    active: root.can-pick;
                    enabled: root.can-pick;
                    clicked => { root.run-pick(root.pick-gripper, root.sel-block); }
                }
            }
        }
        Rectangle {
            height: 64px;
            background: Theme.plate;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.panel-hi;
            HorizontalLayout {
                padding: 6px;
                spacing: 6px;
                Text { text: root.memory-text; color: Theme.text; font-size: 12px; vertical-alignment: center; overflow: elide; }
                Rectangle {
                    width: 104px;
                    height: root.row-h + 8px;
                    border-radius: 8px;
                    clip: true;
                    background: root.forget-enabled ? Theme.panel-hi : Theme.panel;
                    Rectangle {
                        x: 0;
                        width: root.forget-armed && root.forget-enabled ? parent.width : 0px;
                        background: Theme.warn;
                        animate width { duration: root.forget-armed ? 1s : 0ms; easing: linear; }
                    }
                    Text {
                        text: root.forget-enabled ? "忘れさせる\n(1 秒長押し)" : "作業中は\n不可";
                        color: root.forget-enabled ? (root.forget-armed ? #000000 : Theme.text) : Theme.dim;
                        font-size: 13px;
                        width: parent.width;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        enabled: root.forget-enabled;
                        pointer-event(e) => {
                            if e.kind == PointerEventKind.cancel { root.forget-armed = false; return; }
                            if e.button != PointerEventButton.left { return; }
                            if e.kind == PointerEventKind.down { root.forget-armed = true; root.forget-pressed(); }
                            else if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel { root.forget-armed = false; }
                        }
                    }
                }
            }
        }
    }

    // マスへ (right): the held block goes to the position and heading of a shelf column. The lift and the
    // suction stay as they are; the lift is set and the suction released by hand.
    Panel {
        x: root.width - root.margin - self.width;
        y: root.top-y;
        width: root.side-w;
        height: 120px;
        title: "マスへ (列)";
        note: !root.hold-left && !root.hold-right ? "ブロックなし" : "";
        HorizontalLayout {
            height: root.row-h;
            spacing: 4px;
            for c in root.columns: Btn {
                label: "列 \{c}";
                active: root.sel-column == c;
                min-width: 52px;
                clicked => { root.sel-column = c; }
            }
        }
        HorizontalLayout {
            height: root.row-h;
            spacing: 8px;
            SidePick { value <=> root.place-gripper; left-ok: root.hold-left; right-ok: root.hold-right; }
            Btn {
                label: "マスへ";
                tint: Theme.ok;
                active: root.can-shelf-cell;
                enabled: root.can-shelf-cell;
                clicked => { root.run-shelf-cell(root.place-gripper, root.sel-column); }
            }
        }
    }

    // 2 個同時に回収: gripper0 (左) takes the first block, gripper1 (右) the one below it.
    Panel {
        x: root.width - root.margin - self.width;
        y: root.top-y + 124px;
        width: root.side-w;
        height: 72px;
        title: "2 個同時に回収 (左+右)";
        HorizontalLayout {
            height: root.row-h;
            spacing: 8px;
            Btn { label: "4+3"; tint: Theme.ok; active: root.can-pair-43; enabled: root.can-pair-43; clicked => { root.run-pair(4); } }
            Btn { label: "2+1"; tint: Theme.ok; active: root.can-pair-21; enabled: root.can-pair-21; clicked => { root.run-pair(2); } }
        }
    }

    // Bottom: moves, then paths / follow / cancel / pose pick.
    VerticalLayout {
        x: root.margin;
        y: root.height - root.margin - self.height;
        width: root.width - 2 * root.margin;
        height: 2 * root.row-h + 4px;
        spacing: 4px;
        HorizontalLayout {
            spacing: 4px;
            Btn { label: "スタートへ"; enabled: root.usable; font: 13px; min-width: 70px; clicked => { root.run-move(2); } }
            Btn { label: "棚の前へ"; enabled: root.usable; font: 13px; min-width: 70px; clicked => { root.run-move(7); } }
            Btn { label: "スラロームの入口へ"; enabled: root.usable; font: 13px; min-width: 70px; clicked => { root.run-move(1); } }
            Btn { label: "スラロームの出口へ"; enabled: root.usable; font: 13px; min-width: 70px; clicked => { root.run-move(6); } }
            Btn { label: "スラローム往路"; enabled: root.usable; font: 13px; min-width: 70px; clicked => { root.run-move(3); } }
            Btn { label: "スラローム復路"; enabled: root.usable; font: 13px; min-width: 70px; clicked => { root.run-move(4); } }
        }
        HorizontalLayout {
            spacing: 4px;
            for p in root.paths: Btn {
                label: p;
                active: p == root.active-path;
                enabled: root.usable;
                font: 13px;
                min-width: 64px;
                clicked => { root.start-path(p); }
            }
            Btn { label: "経路の停止"; font: 13px; min-width: 84px; enabled: root.link-ok; tint: Theme.danger; clicked => { root.stop-path(); } }
            Btn { label: root.tracker ? "追従 入" : "追従 切"; active: root.tracker; tint: Theme.ok; font: 13px; min-width: 66px; enabled: root.link-ok && (!root.stopped || root.tracker); clicked => { root.toggle-tracker(); } }
            Btn { label: "取り消し"; active: root.task-active; tint: Theme.danger; font: 13px; min-width: 72px; enabled: root.task-active; clicked => { root.cancel(); } }
            Btn { label: "地図で姿勢を指定"; font: 13px; min-width: 120px; enabled: root.link-ok; clicked => { root.pick-pose(); } }
        }
    }
}
