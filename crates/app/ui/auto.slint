import { Theme } from "theme.slint";
import { Btn } from "manual.slint";
import { MapPane } from "map.slint";

// 左 / 右 chooser. A side that cannot be chosen (`left-ok` / `right-ok` false) is dimmed.
component SidePick inherits HorizontalLayout {
    in-out property <int> value: 0;
    in property <bool> left-ok: true;
    in property <bool> right-ok: true;
    spacing: 6px;
    Btn { label: "左"; active: root.value == 0; enabled: root.left-ok; min-width: 56px; clicked => { root.value = 0; } }
    Btn { label: "右"; active: root.value == 1; enabled: root.right-ok; min-width: 56px; clicked => { root.value = 1; } }
}

// A panel with a heading.
component Panel inherits Rectangle {
    in property <string> title;
    background: Theme.panel;
    border-radius: 8px;
    @children
    Text { x: 8px; y: 4px; text: root.title; color: Theme.dim; font-size: 13px; }
}

export component AutoPanel inherits Rectangle {
    background: Theme.bg;

    // Why the task buttons are unusable ("" = usable).
    in property <string> block-reason;
    in property <bool> task-active: false;
    in property <string> task-label;
    in property <string> task-step;
    // 0 free, 1 picked.
    in property <[int]> blocks;
    // Shelf cells, index row * columns + column; 0 empty, 1 placed.
    in property <[int]> cells;
    in property <int> columns: 3;
    in property <int> rows: 3;
    in property <bool> hold-left: false;
    in property <bool> hold-right: false;
    in property <string> place-warning;
    in property <string> memory-text;
    in property <bool> forget-enabled: true;
    in property <[string]> paths;
    in property <string> active-path;
    in property <bool> tracker: false;
    in property <bool> stopped: false;
    in property <string> message;
    in property <bool> message-ok: true;
    in property <bool> link-ok: true;

    in-out property <int> pick-gripper: 0;
    in-out property <int> place-gripper: 0;
    in-out property <int> sel-block: -1;
    in-out property <int> sel-column: -1;
    in-out property <int> sel-row: -1;

    // Map (pane 1).
    in property <image> map-image;
    in property <float> map-cx: 0;
    in property <float> map-cy: 0;
    in property <float> map-scale: 50;
    in property <string> confirm-text;
    in property <bool> confirm-active: false;

    callback run-pick(int, int);
    callback run-place(int, int, int);
    callback run-move(int);
    callback cancel();
    callback forget-pressed();
    callback forget-confirmed();
    callback start-path(string);
    callback stop-path();
    callback toggle-tracker();
    callback map-geometry(length, length);
    callback map-panned(length, length);
    callback map-zoomed(float, length, length);
    callback map-fit();
    callback pose-dragging(float, float, float);
    callback pose-picked(float, float, float);
    callback pose-cancelled();
    callback pose-confirm();
    callback pose-dismiss();

    property <bool> usable: root.block-reason == "" && root.link-ok;
    property <bool> can-pick: root.usable && root.sel-block >= 0 && root.sel-block < root.blocks.length && root.blocks[root.sel-block] == 0;
    property <bool> holds-selected: root.place-gripper == 0 ? root.hold-left : root.hold-right;
    property <bool> can-place: root.usable && root.holds-selected && root.sel-column >= 0 && root.sel-row >= 0;

    changed visible => { if !root.visible { root.forget-armed = false; } }
    changed forget-enabled => { if !root.forget-enabled { root.forget-armed = false; } }
    // 長押し: fires once after 1 s of an uninterrupted press.
    property <bool> forget-armed: false;
    forget-timer := Timer {
        interval: 1s;
        running: root.forget-armed && root.forget-enabled && root.visible;
        triggered => {
            root.forget-armed = false;
            root.forget-confirmed();
        }
    }

    VerticalLayout {
        padding: 8px;
        spacing: 6px;

        // Running task, or why nothing can be started.
        Rectangle {
            height: Theme.tap;
            border-radius: 8px;
            background: root.task-active ? Theme.accent.darker(0.5) : Theme.panel;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 6px;
                spacing: 10px;
                Text {
                    text: root.task-active ? "作業中: \{root.task-label}" : (root.block-reason != "" ? root.block-reason : "作業を選んでください");
                    color: root.task-active || root.block-reason == "" ? Theme.text : Theme.warn;
                    font-size: 18px;
                    font-weight: 700;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Text {
                    text: root.task-active ? (root.task-step == "" ? "段階: —" : "段階: \{root.task-step}") : "";
                    color: Theme.text;
                    font-size: 16px;
                    vertical-alignment: center;
                    overflow: elide;
                }
                if root.task-active: Btn {
                    label: "取り消し";
                    tint: Theme.danger;
                    active: true;
                    min-width: 120px;
                    max-width: 160px;
                    clicked => { root.cancel(); }
                }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            // 回収 and 配置
            VerticalLayout {
                width: 330px;
                spacing: 6px;
                Panel {
                    title: "回収 (0 が外周壁の側)";
                    height: 128px;
                    VerticalLayout {
                        padding: 8px;
                        padding-top: 22px;
                        spacing: 6px;
                        HorizontalLayout {
                            spacing: 4px;
                            for st[i] in root.blocks: Btn {
                                label: st == 1 ? "\{i}済" : "\{i}";
                                enabled: st == 0;
                                active: root.sel-block == i;
                                min-width: 44px;
                                clicked => { root.sel-block = i; }
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            SidePick { value <=> root.pick-gripper; }
                            Btn {
                                label: "回収";
                                tint: Theme.ok;
                                active: root.can-pick;
                                enabled: root.can-pick;
                                clicked => { root.run-pick(root.pick-gripper, root.sel-block); }
                            }
                        }
                    }
                }
                Panel {
                    title: "配置 (棚の列 × 段)";
                    VerticalLayout {
                        padding: 8px;
                        padding-top: 22px;
                        spacing: 4px;
                        for r in root.rows: HorizontalLayout {
                            spacing: 4px;
                            property <int> rr: root.rows - 1 - r;
                            Text { text: "段\{rr}"; color: Theme.dim; font-size: 13px; width: 28px; vertical-alignment: center; }
                            for c in root.columns: Btn {
                                property <bool> placed: root.cells[parent.rr * root.columns + c] == 1;
                                label: placed ? "済 \{c}-\{parent.rr}" : "\{c}-\{parent.rr}";
                                tint: placed ? Theme.ok : Theme.accent;
                                active: placed || (root.sel-column == c && root.sel-row == parent.rr);
                                font: 14px;
                                min-width: 56px;
                                clicked => { root.sel-column = c; root.sel-row = parent.rr; }
                            }
                        }
                        Text { text: "マスの表示は 列-段"; color: Theme.dim; font-size: 12px; horizontal-alignment: center; }
                        HorizontalLayout {
                            spacing: 8px;
                            SidePick { value <=> root.place-gripper; left-ok: root.hold-left; right-ok: root.hold-right; }
                            Btn {
                                label: "配置";
                                tint: Theme.ok;
                                active: root.can-place;
                                enabled: root.can-place;
                                clicked => { root.run-place(root.place-gripper, root.sel-column, root.sel-row); }
                            }
                        }
                        Text {
                            text: !root.hold-left && !root.hold-right ? "ブロックを持っていません" : root.place-warning;
                            color: Theme.warn;
                            font-size: 13px;
                            wrap: word-wrap;
                            min-height: 18px;
                        }
                    }
                }
            }
            // 移動 and memory
            VerticalLayout {
                width: 210px;
                spacing: 6px;
                Panel {
                    title: "移動";
                    VerticalLayout {
                        padding: 8px;
                        padding-top: 22px;
                        spacing: 6px;
                        Btn { label: "スタートへ"; enabled: root.usable; clicked => { root.run-move(2); } }
                        Btn { label: "スラロームの入口へ"; enabled: root.usable; font: 14px; clicked => { root.run-move(1); } }
                        Btn { label: "スラロームの出口へ"; enabled: root.usable; font: 14px; clicked => { root.run-move(6); } }
                        Btn { label: "スラローム往路"; enabled: root.usable; font: 14px; clicked => { root.run-move(3); } }
                        Btn { label: "スラローム復路"; enabled: root.usable; font: 14px; clicked => { root.run-move(4); } }
                    }
                }
                Panel {
                    title: "覚えていること";
                    height: 160px;
                    VerticalLayout {
                        padding: 8px;
                        padding-top: 22px;
                        spacing: 6px;
                        Text { text: root.memory-text; color: Theme.text; font-size: 13px; wrap: word-wrap; vertical-alignment: top; }
                        Rectangle {
                            height: Theme.tap - 4px;
                            border-radius: 8px;
                            clip: true;
                            background: root.forget-enabled ? Theme.panel-hi : Theme.panel;
                            Rectangle {
                                x: 0;
                                width: root.forget-armed && root.forget-enabled ? parent.width : 0px;
                                background: Theme.warn;
                                animate width { duration: root.forget-armed ? 1s : 0ms; easing: linear; }
                            }
                            Text {
                                text: root.forget-enabled ? "忘れさせる(1 秒長押し)" : "作業中は忘れさせられません";
                                color: root.forget-enabled ? (root.forget-armed ? #000000 : Theme.text) : Theme.dim;
                                font-size: 14px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            TouchArea {
                                enabled: root.forget-enabled;
                                pointer-event(e) => {
                                    if e.kind == PointerEventKind.cancel { root.forget-armed = false; return; }
                                    if e.button != PointerEventButton.left { return; }
                                    if e.kind == PointerEventKind.down { root.forget-armed = true; root.forget-pressed(); }
                                    else if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel { root.forget-armed = false; }
                                }
                            }
                        }
                    }
                }
            }
            // Map with pose picking.
            Rectangle {
                clip: true;
                border-radius: 8px;
                MapPane {
                    width: parent.width;
                    height: parent.height;
                    pane-id: 1;
                    pose-pick-enabled: root.link-ok && !root.confirm-active;
                    image: root.map-image;
                    view-cx: root.map-cx;
                    view-cy: root.map-cy;
                    view-scale: root.map-scale;
                    geometry(w, h) => { root.map-geometry(w, h); }
                    panned(dx, dy) => { root.map-panned(dx, dy); }
                    zoomed(f, x, y) => { root.map-zoomed(f, x, y); }
                    fit-pressed => { root.map-fit(); }
                    pose-dragging(x, y, yaw) => { root.pose-dragging(x, y, yaw); }
                    pose-picked(x, y, yaw) => { root.pose-picked(x, y, yaw); }
                    pose-cancelled => { root.pose-cancelled(); }
                }
                Text {
                    x: 8px;
                    y: 6px;
                    text: "自己位置: 地図を長押ししてドラッグ";
                    color: Theme.dim;
                    font-size: 13px;
                }
                if root.confirm-active: Rectangle {
                    x: 8px;
                    y: 28px;
                    width: parent.width - 16px;
                    height: 92px;
                    background: #12161cf0;
                    border-radius: 8px;
                    border-width: 2px;
                    border-color: Theme.accent;
                    TouchArea { }
                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;
                        Text { text: "自己位置をここにしますか?  \{root.confirm-text}"; color: Theme.text; font-size: 15px; wrap: word-wrap; }
                        HorizontalLayout {
                            spacing: 8px;
                            Btn { label: "決定"; active: true; tint: Theme.ok; clicked => { root.pose-confirm(); } }
                            Btn { label: "取消"; clicked => { root.pose-dismiss(); } }
                        }
                    }
                }
            }
        }

        // 経路 (small)
        HorizontalLayout {
            height: 40px;
            spacing: 6px;
            Text { text: "経路"; color: Theme.dim; font-size: 13px; vertical-alignment: center; }
            for p in root.paths: Btn {
                label: p;
                active: p == root.active-path;
                enabled: root.usable;
                font: 13px;
                min-height: 36px;
                min-width: 80px;
                clicked => { root.start-path(p); }
            }
            Rectangle { }
            Btn { label: "経路の停止"; font: 13px; min-height: 36px; min-width: 100px; enabled: root.link-ok; tint: Theme.danger; clicked => { root.stop-path(); } }
            Btn { label: root.tracker ? "追従 入" : "追従 切"; active: root.tracker; tint: Theme.ok; font: 13px; min-height: 36px; min-width: 90px; enabled: root.link-ok && (!root.stopped || root.tracker); clicked => { root.toggle-tracker(); } }
        }

        // Result line
        Text {
            height: 24px;
            text: root.message;
            color: root.message-ok ? Theme.text : Theme.warn;
            font-size: 15px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}
