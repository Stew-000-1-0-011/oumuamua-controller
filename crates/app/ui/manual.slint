import { Theme } from "theme.slint";

export struct PresetInfo { name: string, enabled: bool }

// A plain button; `active` shows a latched state.
export component Btn inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    in property <bool> enabled: true;
    in property <color> tint: Theme.accent;
    in property <length> font: Theme.font;
    callback clicked();
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => { if root.enabled { root.clicked(); } }
    min-height: Theme.tap - 4px;
    min-width: Theme.tap;
    border-radius: 8px;
    background: !root.enabled ? Theme.panel
        : root.active ? root.tint
        : ta.pressed ? Theme.panel-hi.brighter(0.3)
        : Theme.panel-hi;
    Text {
        text: root.label;
        color: root.enabled ? Theme.text : Theme.dim;
        font-size: root.font;
        font-weight: root.active ? 700 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}

// 上 / 下: acts only while held. Each press and release is reported once.
component JogButton inherits Rectangle {
    in property <string> label;
    // Spoken / test name when the glyph alone is not enough (ハリテ ▲).
    in property <string> a11y;
    in property <bool> enabled: true;
    callback pressed();
    callback released();
    accessible-role: button;
    accessible-label: root.a11y != "" ? root.a11y : root.label;
    accessible-enabled: root.enabled;
    min-height: Theme.tap - 4px;
    min-width: Theme.tap - 4px;
    border-radius: 8px;
    background: !root.enabled ? Theme.panel : ta.pressed ? Theme.accent : Theme.panel-hi;
    Text {
        text: root.label;
        color: root.enabled ? Theme.text : Theme.dim;
        font-size: 18px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    // A disabled (or hidden) button never sees the finger-up: release here.
    changed enabled => { if !root.enabled { root.released(); } }
    ta := TouchArea {
        enabled: root.enabled;
        pointer-event(e) => {
            // A cancel (Exit while held) carries button `other`; it must still release the jog.
            if e.kind == PointerEventKind.cancel { root.released(); return; }
            if e.button != PointerEventButton.left { return; }
            if e.kind == PointerEventKind.down { root.pressed(); }
            else if e.kind == PointerEventKind.up { root.released(); }
        }
    }
}

// Translation stick. Reports the deflection (-1..1, screen right / screen down) while a finger
// is down and (0, 0) the moment it lifts.
component Stick inherits Rectangle {
    in property <bool> enabled: true;
    callback moved(float, float);
    property <length> d: Math.min(self.width, self.height);
    property <length> knob: 60px;
    property <length> reach: (root.d - root.knob) / 2;
    property <float> kx: 0;
    property <float> ky: 0;

    pure function clamp1(v: float) -> float { return Math.max(-1, Math.min(1, v)); }
    // A disabled (or hidden) stick never sees the finger-up: centre the knob and report zero.
    changed enabled => { if !root.enabled { root.kx = 0; root.ky = 0; root.moved(0, 0); } }

    Rectangle {
        width: root.d;
        height: root.d;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: self.width / 2;
        background: Theme.plate;
        border-width: 2px;
        border-color: Theme.panel-hi;
        Text { y: parent.height - 30px; text: "並進"; color: Theme.dim; font-size: 14px; width: parent.width; horizontal-alignment: center; }
        Rectangle {
            width: root.knob;
            height: root.knob;
            border-radius: root.knob / 2;
            background: root.enabled ? Theme.accent : Theme.panel-hi;
            x: (parent.width - self.width) / 2 + root.kx * root.reach;
            y: (parent.height - self.height) / 2 + root.ky * root.reach;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        pointer-event(e) => {
            if e.button != PointerEventButton.left && e.button != PointerEventButton.other { return; }
            if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel {
                root.kx = 0;
                root.ky = 0;
                root.moved(0, 0);
            } else if e.kind == PointerEventKind.down {
                root.kx = root.clamp1((self.mouse-x - root.width / 2) / root.reach);
                root.ky = root.clamp1((self.mouse-y - root.height / 2) / root.reach);
                root.moved(root.kx, root.ky);
            }
        }
        moved => {
            if !self.pressed { return; }
            root.kx = root.clamp1((self.mouse-x - root.width / 2) / root.reach);
            root.ky = root.clamp1((self.mouse-y - root.height / 2) / root.reach);
            root.moved(root.kx, root.ky);
        }
    }
}

// Horizontal rotation slider; springs back to 0 on release.
component Slider inherits Rectangle {
    in property <bool> enabled: true;
    callback moved(float);
    property <length> knob: 56px;
    property <length> reach: (self.width - root.knob) / 2;
    property <float> k: 0;
    pure function clamp1(v: float) -> float { return Math.max(-1, Math.min(1, v)); }
    changed enabled => { if !root.enabled { root.k = 0; root.moved(0); } }

    Rectangle {
        height: root.knob;
        y: (parent.height - self.height) / 2;
        border-radius: root.knob / 2;
        background: Theme.plate;
        border-width: 2px;
        border-color: Theme.panel-hi;
        Rectangle { width: 2px; height: parent.height * 0.5; x: parent.width / 2; y: parent.height * 0.25; background: Theme.dim; }
        Rectangle {
            width: root.knob;
            height: root.knob;
            border-radius: root.knob / 2;
            background: root.enabled ? Theme.accent : Theme.panel-hi;
            x: (parent.width - self.width) / 2 + root.k * root.reach;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        pointer-event(e) => {
            if e.button != PointerEventButton.left && e.button != PointerEventButton.other { return; }
            if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel {
                root.k = 0;
                root.moved(0);
            } else if e.kind == PointerEventKind.down {
                root.k = root.clamp1((self.mouse-x - root.width / 2) / root.reach);
                root.moved(root.k);
            }
        }
        moved => {
            if !self.pressed { return; }
            root.k = root.clamp1((self.mouse-x - root.width / 2) / root.reach);
            root.moved(root.k);
        }
    }
}

// A semi-transparent plate behind a group of controls, so the map shows through around them.
component Plate inherits Rectangle {
    background: Theme.plate;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.panel-hi;
}

// One lift + suction column. `side` 0 is left, 1 is right.
component LiftColumn inherits Plate {
    in property <string> title;
    in property <string> info;
    in property <int> side;
    in property <[PresetInfo]> presets;
    in property <bool> suction;
    // Stopped: the robot refuses lift motion and suction-on.
    in property <bool> stopped: false;
    callback jog-pressed(int);
    callback jog-released(int);
    callback preset(int);
    callback suction-toggled();

    VerticalLayout {
        padding: 4px;
        spacing: 3px;
        HorizontalLayout {
            height: 16px;
            spacing: 6px;
            Text { text: root.title; color: Theme.text; font-size: 14px; font-weight: 700; vertical-alignment: center; }
            Text { text: root.info; color: Theme.dim; font-size: 12px; vertical-alignment: center; overflow: elide; }
        }
        HorizontalLayout {
            height: 44px;
            spacing: 4px;
            JogButton { label: "上"; enabled: !root.stopped; pressed => { root.jog-pressed(1); } released => { root.jog-released(root.side); } }
            JogButton { label: "下"; enabled: !root.stopped; pressed => { root.jog-pressed(-1); } released => { root.jog-released(root.side); } }
            Btn {
                label: root.suction ? "吸引 入" : "吸引 切";
                active: root.suction;
                tint: Theme.ok;
                font: 14px;
                min-width: 80px;
                enabled: !root.stopped || root.suction;
                clicked => { root.suction-toggled(); }
            }
        }
        HorizontalLayout {
            height: 44px;
            spacing: 4px;
            for p[i] in root.presets: Btn {
                label: p.name;
                enabled: p.enabled && !root.stopped;
                font: 13px;
                min-width: 44px;
                clicked => { root.preset(i); }
            }
        }
    }
}

// ハリテ: a lift without suction, driven only while ▲ / ▼ is held (the robot gets a speed, there is no
// height). `blocked` is stopped, hidden or auto: both buttons are released and disabled.
component HariteColumn inherits Plate {
    in property <string> info;
    in property <bool> blocked: false;
    callback pressed(int);
    callback released();
    min-width: 100px;
    max-width: 100px;
    horizontal-stretch: 0;

    VerticalLayout {
        padding: 4px;
        spacing: 3px;
        Text { height: 16px; text: "ハリテ"; color: Theme.text; font-size: 14px; font-weight: 700; vertical-alignment: center; }
        HorizontalLayout {
            height: 44px;
            spacing: 4px;
            JogButton { label: "▲"; a11y: "ハリテ 上"; enabled: !root.blocked; pressed => { root.pressed(1); } released => { root.released(); } }
            JogButton { label: "▼"; a11y: "ハリテ 下"; enabled: !root.blocked; pressed => { root.pressed(-1); } released => { root.released(); } }
        }
        VerticalLayout {
            height: 44px;
            alignment: center;
            Text { text: "指令"; color: Theme.dim; font-size: 11px; horizontal-alignment: center; }
            Text { text: root.info; color: Theme.text; font-size: 13px; horizontal-alignment: center; overflow: elide; }
        }
    }
}

// Drawn over the output screen: no background of its own, only plates around the controls.
export component ManualPanel inherits Rectangle {
    background: transparent;
    // 0 低, 1 中, 2 高
    in-out property <int> level: 0;
    in-out property <bool> field-frame: false;
    in-out property <bool> both: false;
    in property <[PresetInfo]> presets;
    in property <string> lift-reason;
    in property <string> left-info: "高さ —  目標 —";
    in property <string> right-info: "高さ —  目標 —";
    in property <bool> left-suction: false;
    in property <bool> right-suction: false;
    in property <bool> reset-enabled: true;
    in property <bool> stopped: false;
    in property <string> message;
    in property <bool> auto-active: false;
    in property <string> auto-label;
    in property <string> speed-text;
    // The bridge drives harite (CONFIG says so): shows the ハリテ column. Off for an older bridge.
    in property <bool> harite-visible: false;
    in property <string> harite-text: "-";

    callback stick-moved(float, float);
    callback slider-moved(float);
    callback jog-pressed(int, int);
    callback jog-released(int);
    callback preset-pressed(int, int);
    callback suction-toggled(int);
    callback reset-pressed();
    callback reset-confirmed();
    callback cancel-auto();
    callback harite-pressed(int);
    callback harite-released();
    // The column leaving the tree (CONFIG changed) takes a held finger's release with it.
    changed harite-visible => { if !root.harite-visible { root.harite-released(); } }
    changed visible => { if !root.visible { root.reset-armed = false; } }
    // A disabled TouchArea never reports the finger-up, so disarm here.
    changed reset-enabled => { if !root.reset-enabled { root.reset-armed = false; } }

    // 長押し: the timer fires once after 1 s of an uninterrupted press.
    property <bool> reset-armed: false;
    reset-timer := Timer {
        interval: 1s;
        running: root.reset-armed && root.reset-enabled;
        triggered => {
            root.reset-armed = false;
            root.reset-confirmed();
        }
    }

    property <length> margin: 8px;
    property <length> stick-d: min(max(root.height * 0.42, 156px), 240px);
    property <length> slider-w: min(max(root.width * 0.34, 260px), 420px);
    // Below the status band (it stays readable).
    property <length> top-y: Theme.band-h + 4px;
    // Not enough height for the group above the stick: the group moves right of the stick.
    property <bool> beside-stick: root.top-y + 188px + 4px > root.height - root.margin - root.stick-d;
    property <length> group-w: min(520px, root.width - 2 * root.margin - (root.beside-stick ? root.stick-d + root.margin : 0px));
    property <length> group-x: root.beside-stick ? root.width - root.margin - root.group-w : (root.width - root.group-w) / 2;

    // Swallows every touch that no control takes, so nothing reaches the output screen below.
    TouchArea { }

    // Top centre: speed level, frame, both, reset, and the two lifts.
    VerticalLayout {
        x: root.group-x;
        y: root.top-y;
        width: root.group-w;
        spacing: 4px;
        Plate {
            height: 66px;
            VerticalLayout {
                padding: 4px;
                spacing: 2px;
                HorizontalLayout {
                    height: 44px;
                    spacing: 4px;
                    Btn { label: "低"; min-width: 44px; active: root.level == 0; clicked => { root.level = 0; } }
                    Btn { label: "中"; min-width: 44px; active: root.level == 1; clicked => { root.level = 1; } }
                    Btn { label: "高"; min-width: 44px; active: root.level == 2; clicked => { root.level = 2; } }
                    Btn { label: "ロボット"; min-width: 64px; active: !root.field-frame; font: 13px; clicked => { root.field-frame = false; } }
                    Btn { label: "フィールド"; min-width: 80px; active: root.field-frame; font: 13px; clicked => { root.field-frame = true; } }
                    Btn { label: "両方"; min-width: 48px; active: root.both; clicked => { root.both = !root.both; } }
                    Rectangle {
                        min-width: 100px;
                        accessible-role: button;
                        accessible-label: "リセット";
                        accessible-enabled: root.reset-enabled;
                        border-radius: 8px;
                        clip: true;
                        background: root.reset-enabled ? Theme.panel-hi : Theme.panel;
                        Rectangle {
                            x: 0;
                            width: root.reset-armed && root.reset-enabled ? parent.width : 0px;
                            background: Theme.warn;
                            animate width { duration: root.reset-armed ? 1s : 0ms; easing: linear; }
                        }
                        Text {
                            text: root.reset-enabled ? "リセット(1 秒長押し)" : (root.stopped ? "停止中は不可" : "動作中は不可");
                            color: root.reset-enabled ? (root.reset-armed ? #000000 : Theme.text) : Theme.dim;
                            font-size: 12px;
                            width: parent.width;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        TouchArea {
                            enabled: root.reset-enabled;
                            pointer-event(e) => {
                                if e.kind == PointerEventKind.cancel { root.reset-armed = false; return; }
                                if e.button != PointerEventButton.left { return; }
                                if e.kind == PointerEventKind.down { root.reset-armed = true; root.reset-pressed(); }
                                else if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel { root.reset-armed = false; }
                            }
                        }
                    }
                }
                Text { height: 14px; text: root.speed-text; color: Theme.dim; font-size: 12px; horizontal-alignment: center; overflow: elide; }
            }
        }
        HorizontalLayout {
            height: 118px;
            spacing: 6px;
            LiftColumn {
                title: "左";
                side: 0;
                info: root.left-info;
                presets: root.presets;
                suction: root.left-suction;
                stopped: root.stopped || !root.visible;
                jog-pressed(d) => { root.jog-pressed(0, d); }
                jog-released(s) => { root.jog-released(s); }
                preset(i) => { root.preset-pressed(0, i); }
                suction-toggled => { root.suction-toggled(0); }
            }
            LiftColumn {
                title: "右";
                side: 1;
                info: root.right-info;
                presets: root.presets;
                suction: root.right-suction;
                stopped: root.stopped || !root.visible;
                jog-pressed(d) => { root.jog-pressed(1, d); }
                jog-released(s) => { root.jog-released(s); }
                preset(i) => { root.preset-pressed(1, i); }
                suction-toggled => { root.suction-toggled(1); }
            }
            if root.harite-visible: HariteColumn {
                info: root.harite-text;
                // Like the lift buttons: stopped, page hidden, and also while the auto popup covers them.
                blocked: root.stopped || !root.visible || root.auto-active;
                pressed(d) => { root.harite-pressed(d); }
                released => { root.harite-released(); }
            }
        }
    }

    // Bottom left: translation stick.
    Stick {
        x: root.margin;
        y: root.height - root.margin - root.stick-d;
        width: root.stick-d;
        height: root.stick-d;
        // Hidden (another page showing) counts as disabled: the panel stays alive, so a
        // held finger must be let go of.
        enabled: !root.auto-active && root.visible;
        moved(x, y) => { root.stick-moved(x, y); }
    }

    // Bottom right: rotation slider.
    Plate {
        x: root.width - root.margin - root.slider-w;
        y: root.height - root.margin - 84px;
        width: root.slider-w;
        height: 84px;
        Text { y: 4px; text: "旋回"; color: Theme.dim; font-size: 14px; width: parent.width; horizontal-alignment: center; }
        Slider {
            x: 8px;
            y: 22px;
            width: parent.width - 16px;
            height: 56px;
            enabled: !root.auto-active && root.visible;
            moved(s) => { root.slider-moved(s); }
        }
    }

    // Bottom centre: why a lift is refused, or the last result.
    Plate {
        property <length> left-edge: root.margin + root.stick-d + root.margin;
        x: self.left-edge;
        width: root.width - root.slider-w - 3 * root.margin - root.stick-d;
        height: 44px;
        y: root.height - root.margin - self.height;
        visible: root.lift-reason != "" || root.message != "";
        VerticalLayout {
            padding: 4px;
            alignment: center;
            Text { text: root.lift-reason; color: Theme.warn; font-size: 12px; horizontal-alignment: center; wrap: word-wrap; visible: root.lift-reason != ""; }
            Text { text: root.message; color: Theme.warn; font-size: 12px; horizontal-alignment: center; wrap: word-wrap; visible: root.message != ""; }
        }
    }

    if root.auto-active: Rectangle {
        background: #12161cf4;
        TouchArea { }
        VerticalLayout {
            alignment: center;
            spacing: 10px;
            Text { text: "自動走行中"; color: Theme.text; font-size: 28px; font-weight: 700; horizontal-alignment: center; }
            Text { text: root.auto-label; color: Theme.dim; font-size: 18px; horizontal-alignment: center; }
            HorizontalLayout {
                alignment: center;
                Btn {
                    label: "手動制御へ";
                    active: true;
                    min-width: 200px;
                    min-height: 56px;
                    font: 20px;
                    clicked => { root.cancel-auto(); }
                }
            }
        }
    }
}
