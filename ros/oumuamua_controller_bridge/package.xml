<?xml version="1.0"?>
<package format="3">
  <name>oumuamua_controller_bridge</name>
  <version>0.1.0</version>
  <description>UDP/MessagePack bridge between the oumuamua Android controller and ROS 2</description>
  <maintainer email="noreply@anthropic.com">oumuamua</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>mini_shirasu_ros</exec_depend>
  <exec_depend>gripper</exec_depend>
  <exec_depend>task_commander</exec_depend>
  <exec_depend>python3-msgpack</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
